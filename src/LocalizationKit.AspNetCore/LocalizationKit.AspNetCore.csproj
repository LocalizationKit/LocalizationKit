<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>LocalizationKit.AspNetCore</PackageId>
    <Description>Per-request culture for LocalizationKit on ASP.NET Core: negotiates the culture from the query string, the route, a cookie or Accept-Language, and serves each request in its own language without touching the others.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocalizationKit\LocalizationKit.csproj" />
  </ItemGroup>

</Project>
