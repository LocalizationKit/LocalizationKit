<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>false</EnableMsixTooling>
    <PackageId>LocalizationKit.WinUI</PackageId>
    <Description>WinUI 3 integration for LocalizationKit: a loc:Text markup extension and loc:Loc attached properties that resolve translations in XAML and refresh themselves when the culture changes.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocalizationKit\LocalizationKit.csproj" />
  </ItemGroup>

</Project>
