<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>LocalizationKit.StringLocalizer</PackageId>
    <Description>Microsoft.Extensions.Localization compatibility for LocalizationKit: serves IStringLocalizer, IStringLocalizer&lt;T&gt; and IStringLocalizerFactory from LocalizationKit's resources, so existing code adopts it without being rewritten.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocalizationKit\LocalizationKit.csproj" />
  </ItemGroup>

</Project>
