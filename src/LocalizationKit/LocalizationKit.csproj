<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>LocalizationKit</PackageId>
    <Description>One localization API for every .NET application: resource providers, runtime culture switching, observable localized strings and culture-aware formatting, with no dependency on any UI framework.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LocalizationKit.Tests" />
  </ItemGroup>

</Project>
