<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- Not `LocalizationKit`: that id is taken on nuget.org by an unrelated and unlisted
         package, so it can never be published under. The assembly and the namespaces are
         unaffected and stay `LocalizationKit`. -->
    <PackageId>LocalizationKit.Core</PackageId>
    <Description>One localization API for every .NET application: resource providers, runtime culture switching, observable localized strings and culture-aware formatting, with no dependency on any UI framework.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LocalizationKit.Tests" />
  </ItemGroup>

</Project>
