<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RollForward>Major</RollForward>
    <!-- Do not rename the assembly to "localizationkit": on a case-insensitive file system it would
         collide with LocalizationKit.dll in the output folder and shadow the core library.
         ToolCommandName is what names the installed command. -->
    <RootNamespace>LocalizationKit.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>localizationkit</ToolCommandName>
    <PackageId>LocalizationKit.Cli</PackageId>
    <Description>Command line tool for LocalizationKit: add a culture, sync the local Visual Studio files, and validate resources.</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LocalizationKit.Tooling\LocalizationKit.Tooling.csproj" />
  </ItemGroup>

</Project>
