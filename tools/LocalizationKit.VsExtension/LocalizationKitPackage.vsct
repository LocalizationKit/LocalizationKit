<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidPackage">
    <Groups>
      <!-- Under Tools, where a window that edits the project's files belongs. -->
      <Group guid="guidCommandSet" id="GroupToolsMenu" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidCommandSet" id="OpenEditorCommand" priority="0x0100" type="Button">
        <Parent guid="guidCommandSet" id="GroupToolsMenu" />
        <Strings>
          <ButtonText>LocalizationKit Resw Editor</ButtonText>
          <CommandName>LocalizationKit Resw Editor</CommandName>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <Symbols>
    <GuidSymbol name="guidPackage" value="{3a6d1f40-7d1e-4a9c-bb6f-5a1c0f6d2b31}" />
    <GuidSymbol name="guidCommandSet" value="{b1f3b0c8-2d0a-4d2e-9c1b-6e5a7d3f8c24}">
      <IDSymbol name="GroupToolsMenu" value="0x1020" />
      <IDSymbol name="OpenEditorCommand" value="0x0100" />
    </GuidSymbol>
  </Symbols>

</CommandTable>
